# .env.local.example — copy to .env.local (which is gitignored).
#
# THIS FILE IS FOR THE NEXT.JS APP ONLY, AND IT HOLDS NO SECRETS.
#
# Every variable here is prefixed NEXT_PUBLIC_, which means Next.js inlines its
# value into the JavaScript bundle at build time. Anyone who opens the site can
# read all of it. That is fine for the values below — they are public by design
# — and it is why NO PAYPAL CREDENTIAL APPEARS IN THIS FILE.
#
# In particular: PAYPAL_CLIENT_SECRET must NEVER be put here, with or without
# the prefix. This app has no server runtime (every page is static and talks to
# Supabase from the browser), so there is nowhere in it that a secret could
# safely live. PayPal credentials belong in Supabase Edge Function secrets —
# see supabase/functions/.env.example and BILLING.md §2.

# ---------------------------------------------------------------------------
# Supabase — required. Both are public keys; RLS is the real boundary.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# Billing — all optional. Defaults live in lib/billing-plans.js, which is the
# source of truth; these only override it without a code change.
# ---------------------------------------------------------------------------

# The currency PayPal actually charges. Defaults to USD, because PayPal cannot
# charge SAR. Set to SAR only when a SAR-capable provider is live.
# NEXT_PUBLIC_BILLING_CURRENCY=USD

# Prices in MINOR UNITS, always integers. 1200 = 12.00 SAR, 320 = 3.20 USD.
# The SAR pair is what customers are quoted; the USD pair is what is debited.
# Changing a USD price here does NOT change PayPal — re-run billing-plans-sync.
# NEXT_PUBLIC_PLAN_PRICE_MONTHLY=1200
# NEXT_PUBLIC_PLAN_PRICE_YEARLY=12000
# NEXT_PUBLIC_PLAN_PRICE_MONTHLY_USD=320
# NEXT_PUBLIC_PLAN_PRICE_YEARLY_USD=3200

# supabase/functions/.env.example — copy to supabase/functions/.env
#
# THIS IS THE SECRET SIDE, AND IT IS FOR LOCAL DEVELOPMENT ONLY.
#
# `supabase functions serve --env-file ./supabase/functions/.env` reads this
# file to run the Edge Functions on your machine. NOTHING HERE IS EVER BUNDLED
# INTO THE BROWSER: these values are read by Deno on the server side only, via
# Deno.env.get(), and the app has no way to see them.
#
# The real .env is gitignored (the root .gitignore's `.env` pattern matches at
# any depth). Verify with:  git check-ignore -v supabase/functions/.env
#
# IN PRODUCTION THIS FILE IS NOT USED. Deployed functions read the same names
# from Supabase Edge Function Secrets:
#     supabase secrets set PAYPAL_CLIENT_SECRET=...
# or the dashboard: Project settings -> Edge Functions -> Secrets.
#
# Use SANDBOX credentials here and LIVE credentials only in the production
# secrets. Never the other way round, and never both in one place.

# ---------------------------------------------------------------------------
# PayPal — from developer.paypal.com -> Apps & Credentials
# ---------------------------------------------------------------------------
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret

# From the webhook you create in the same PayPal app (BILLING.md §3.2).
# Without it EVERY webhook is rejected — verification cannot be attempted.
PAYPAL_WEBHOOK_ID=your-sandbox-webhook-id

# 'sandbox' or 'live'. Also selects which provider_plans rows are used, so the
# two environments cannot charge against each other's plan ids.
PAYPAL_ENV=sandbox

# ---------------------------------------------------------------------------
# This platform's own billing secrets
# ---------------------------------------------------------------------------

# Signs the owner's payment links. At least 32 characters or the functions
# refuse to sign, because a short key is a forgeable one.
#   openssl rand -base64 48
BILLING_GRANT_SECRET=generate-a-long-random-string-at-least-32-chars

# Comma-separated allow-list of hosts a checkout may return to. This is the
# open-redirect guard, and it FAILS CLOSED: leave it empty and no checkout can
# start at all.
BILLING_RETURN_HOSTS=localhost,designakum.site

# Optional. Defaults to paypal; the registry is in _shared/provider.ts.
# BILLING_PROVIDER=paypal

# ---------------------------------------------------------------------------
# Mail — every email this platform sends goes through Resend.
#
# Read by invite-client, client-recovery, signup-start and
# request-password-reset. Supabase's own mailer is not on any live path (see
# supabase/EMAIL-TEMPLATES.md), so without RESEND_API_KEY the product sends NO
# mail at all: no invite, no credentials, no signup verification, and no
# password reset.
#
# That failure is deliberately quiet — each mail path logs and returns success,
# because the alternative (a 500 on request-password-reset) would tell an
# anonymous caller which addresses have accounts. The consequence is that a
# missing key looks exactly like working software from the outside. If mail
# stops arriving, check this FIRST, in the function logs.
# ---------------------------------------------------------------------------

# From resend.com -> API Keys. Needs send permission on the MAIL_FROM domain.
RESEND_API_KEY=your-resend-api-key

# The From header, and it must be on a domain verified in Resend or every send
# is rejected. Optional — defaults to the value below in code.
# MAIL_FROM=Designakum <noreply@designakum.site>

# The origin used to build emailed links: the signup verification link and the
# /reset-password link. It must be the site the customer actually opens, or the
# link 404s. Optional — defaults to the value below in code.
#
# NOTE the name: SIGNUP_SITE_URL, set once and used by both mail paths. Kept as
# it is because renaming it would silently fall back to the default on every
# deployed function until the secret was re-set under the new name.
# SIGNUP_SITE_URL=https://designakum.site

# ---------------------------------------------------------------------------
# Supabase — LOCAL SERVE ONLY.
# The deployed runtime injects these three automatically, so they must NOT be
# added to Supabase Secrets (it will reject the reserved SUPABASE_ prefix).
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
